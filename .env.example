# KhoAI - Mau cau hinh LOCAL cho WampServer. KHONG commit .env that len GitHub.
APP_NAME=KhoAI
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://khoai.test
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

LOG_CHANNEL=stack
LOG_LEVEL=debug
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=khoai_db
DB_USERNAME=root
DB_PASSWORD=

# Dung luu local de chay demo don gian, khong can migration session/cache/queue.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
